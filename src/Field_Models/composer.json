{
    "name": "moderntribe/square1-field-models",
    "type": "library",
    "description": "Data Transfer Objects (models) and Collections for ACF",
    "license": "GPL-2.0-only",
    "config": {
        "vendor-dir": "vendor",
        "preferred-install": "dist"
    },
    "require": {
        "php": "^8.1",
        "ext-json": "*"
    },
    "autoload": {
        "files": [
            "spatie-aliases.php"
        ],
        "psr-4": {
            "Tribe\\Libs\\Field_Models\\": ""
        }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "5.0-dev"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
