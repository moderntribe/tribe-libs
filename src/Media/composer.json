{
    "name": "moderntribe/square1-media",
    "type": "library",
    "description": "Media utilities for use with SquareOne projects",
    "license": "GPL-2.0-only",
    "config": {
        "vendor-dir": "vendor",
        "preferred-install": "dist"
    },
    "minimum-stability": "dev",
    "require": {
        "php": "^8.1",
        "ext-dom": "*",
        "ext-libxml": "*",
        "ext-zlib": "*",
        "ext-simplexml": "*",
        "enshrined/svg-sanitize": "^0.22",
        "moderntribe/square1-container": "^5.0",
        "moderntribe/square1-cli": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "Tribe\\Libs\\Media\\": ""
        }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "5.0-dev"
        }
    }
}
